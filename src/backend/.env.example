# Copy to .env and fill in if you want the optional LLM-polished copilot phrasing.
# The app runs fully WITHOUT this — the deterministic copilot works with no key at all.

# Optional: only used to polish Grid Copilot answer phrasing on top of the
# deterministic, tool-grounded answer. Never required for correctness.
LLM_API_KEY=
LLM_PROVIDER=none

# CORS origin for the frontend dev server
FRONTEND_ORIGIN=http://localhost:5173
