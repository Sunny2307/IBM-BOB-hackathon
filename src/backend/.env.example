# Copy to .env and fill in if you want Grid Copilot to answer with a real LLM
# (tool-calling, grounded on the same grid_tools functions the deterministic
# router and the MCP server use — so it can never invent asset IDs/scores).
# The app runs fully WITHOUT this: with LLM_PROVIDER=none (or no key set),
# Grid Copilot uses its original deterministic keyword router, unchanged.

# LLM_PROVIDER: "groq" or "none" (default). Groq's free-tier API is
# OpenAI-compatible and needs no credit card: https://console.groq.com/keys
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# CORS origin(s) for the frontend. Comma-separate to allow more than one,
# e.g. when deployed: http://localhost:5173,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Set automatically by Render (RENDER_EXTERNAL_URL) on a live deploy — makes
# the backend self-ping its own /health every 5 min so the free plan doesn't
# spin down from inactivity. Leave unset locally; only needed to override on
# a host that doesn't set RENDER_EXTERNAL_URL.
SELF_PING_URL=
