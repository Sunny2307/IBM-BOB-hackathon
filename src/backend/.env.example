# Copy to .env and fill in if you want Grid Copilot to answer with a real LLM
# (tool-calling, grounded on the same grid_tools functions the deterministic
# router and the MCP server use — so it can never invent asset IDs/scores).
# The app runs fully WITHOUT this: with LLM_PROVIDER=none (or no key set),
# Grid Copilot uses its original deterministic keyword router, unchanged.

# LLM_PROVIDER: "groq" or "none" (default). Groq's free-tier API is
# OpenAI-compatible and needs no credit card: https://console.groq.com/keys
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# WEATHER_SOURCE: "live" (default) pulls a real 7-day forecast per region
# from Open-Meteo — no API key, no account. "synthetic" pins the app to the
# seeded forecast from generate_synthetic_data.py, which is what you want if
# the real forecast is calm everywhere on demo day and you need the storm
# narrative. Any live-fetch failure falls back to synthetic automatically.
WEATHER_SOURCE=live

# CORS origin(s) for the frontend. Comma-separate to allow more than one,
# e.g. when deployed: http://localhost:5173,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Set automatically by Render (RENDER_EXTERNAL_URL) on a live deploy — makes
# the backend self-ping its own /health every 5 min so the free plan doesn't
# spin down from inactivity. Leave unset locally; only needed to override on
# a host that doesn't set RENDER_EXTERNAL_URL.
SELF_PING_URL=

# Postgres connection string (e.g. Neon serverless). Unset today — the app
# still runs fully in-memory from the generated JSON/CSV. Put the real value
# in .env (gitignored) or the host's dashboard, never here.
DATABASE_URL=

# Signing key for the operator-layer JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset, the app uses an ephemeral per-process key and sessions drop on restart.
JWT_SECRET=
